{
  "name": "reviewloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "App Store + Google Play review inbox with AI replies and fix follow-ups",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply reviewloop --local",
    "db:migrate:remote": "wrangler d1 migrations apply reviewloop --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
